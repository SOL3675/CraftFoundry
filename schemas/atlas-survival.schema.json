{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CraftAtlas survival acquisition suite",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minecraft": {
          "type": "string",
          "minLength": 1
        },
        "loader": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "minecraft",
        "loader"
      ]
    },
    "scenario": {
      "type": "object"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "loot",
              "drops",
              "harvesting",
              "worldgen",
              "trades",
              "other"
            ]
          },
          "availability": {
            "enum": [
              "available",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "resource",
          "kind",
          "availability",
          "evidence"
        ]
      }
    },
    "externalSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "loot",
              "drops",
              "harvesting",
              "worldgen",
              "trades",
              "other"
            ]
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "unsupported"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "status",
          "evidence"
        ]
      }
    },
    "mod": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "reachable",
              "unreachable"
            ]
          },
          "without": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "item",
          "expected"
        ]
      },
      "minItems": 1
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
          },
          "mod": {
            "type": "string",
            "minLength": 1
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "unknown": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "mod",
          "processes",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "snapshot",
    "target",
    "scenario",
    "providers",
    "externalSources"
  ]
}
